# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/dance_of_dragons

# Port the server listens on
PORT=3001

# Secret required in the x-admin-secret header for /api/admin/*, GET /api/applications,
# and POST /api/houses/:slug/lord-role
ADMIN_SECRET=change-me

# Optional: comma-separated Discord user IDs that get full owner access to
# the admin dashboard just by signing in with Discord on the site — no admin
# secret typed in at all. Leave unset and the admin secret is the only way in.
OWNER_DISCORD_USER_IDS=

# Required together for the "Lord" role feature — lets a signed-in user with a
# house's assigned Discord role manage that house without knowing its password.
# Leave either unset to disable the feature entirely (every house then falls
# back to password-only access, same as before).
#   DISCORD_GUILD_ID  — your Discord server's ID
#   DISCORD_BOT_TOKEN — a bot's token (Developer Portal → your app → Bot →
#                       Reset Token). The bot must actually be added to that
#                       server. Treat this like a password — never commit it.
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

# Required together for Roblox verification — the second half of the "Lord"
# feature. A Lord must sign in with BOTH Discord (above) and Roblox, and their
# Roblox account must be the exact one an admin assigned to that house. Leave
# either unset and Lord access is disabled entirely (falls back to
# password-only), even if the Discord vars above are set.
#   ROBLOX_CLIENT_ID / ROBLOX_CLIENT_SECRET — from a Roblox OAuth 2.0 app:
#   Roblox Creator Hub → Credentials → OAuth 2.0 Apps → Create app. Add
#   "<your-site-url>/roblox-callback.html" as a redirect URI, and enable the
#   "openid" and "profile" scopes. Treat the secret like a password — never
#   commit it.
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Optional: a Discord webhook for an admin "logs" channel — posts an audit
# trail (lord-role assignments, lock resets, edits a Lord makes to their own
# locked house) so admins can see who changed what. Leave unset to skip this.
WEBHOOK_LOGS=

# Optional: one webhook used for every department that doesn't have its own
# more specific WEBHOOK_<DEPARTMENT> below (create via Server Settings →
# Integrations → Webhooks in Discord). Leave unset and applications are still
# saved to the database — you just won't get a Discord post for them.
WEBHOOK_APPLICATIONS=

# Optional: override the channel for one specific department. Only needed
# once you want separate channels per department instead of the one above.
WEBHOOK_DEVELOPER=
WEBHOOK_WARFARE=
WEBHOOK_LORE=
WEBHOOK_REGIONAL=
WEBHOOK_MEDIA=
WEBHOOK_MODERATION=
WEBHOOK_COMMUNITY=
WEBHOOK_AFL=
