# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/dance_of_dragons

# Port the server listens on
PORT=3001

# Secret required in the x-admin-secret header for /api/admin/*, GET /api/applications,
# and POST /api/houses/:slug/lord-role
ADMIN_SECRET=change-me

# Required together for the "Lord" role feature — lets a signed-in user with a
# house's assigned Discord role manage that house without knowing its password.
# Leave either unset to disable the feature entirely (every house then falls
# back to password-only access, same as before).
#   DISCORD_GUILD_ID  — your Discord server's ID
#   DISCORD_BOT_TOKEN — a bot's token (Developer Portal → your app → Bot →
#                       Reset Token). The bot must actually be added to that
#                       server. Treat this like a password — never commit it.
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

# Optional: one webhook used for every department that doesn't have its own
# more specific WEBHOOK_<DEPARTMENT> below (create via Server Settings →
# Integrations → Webhooks in Discord). Leave unset and applications are still
# saved to the database — you just won't get a Discord post for them.
WEBHOOK_APPLICATIONS=

# Optional: override the channel for one specific department. Only needed
# once you want separate channels per department instead of the one above.
WEBHOOK_DEVELOPER=
WEBHOOK_WARFARE=
WEBHOOK_LORE=
WEBHOOK_REGIONAL=
WEBHOOK_MEDIA=
WEBHOOK_MODERATION=
WEBHOOK_COMMUNITY=
WEBHOOK_AFL=
